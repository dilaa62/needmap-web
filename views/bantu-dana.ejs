<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judulWeb %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-krem">
    <header>
        <div class="logo"><img src="https://github.com/dilaa62/NEEDMAP/blob/main/LOGO.png?raw=true" alt="Logo NEEDMAP" class="logo-img"></div>
        <nav>
            <a href="/tentang">Tentang NEEDMAP</a>
            <a href="/perjalanan">Perjalanan Kami</a>
            <a href="/jelajahi" class="active">Jelajahi NEED</a>
            <a href="/buat">Buat NEED</a>
           <a href="/insight">Insight dan Berita</a>
            <a href="/masuk" class="btn-masuk">Masuk/Daftar</a>
        </nav>
    </header>

    <section class="p-50 teks-hijau-tua">
        <h1 style="font-size: 2.2em; margin-bottom: 5px;">Bantu Melalui Dana</h1>
        <h3 style="margin-top: 0; margin-bottom: 20px;">Berikan kontribusi untuk membantu memenuhi kebutuhan ini</h3>
        <p style="font-size: 1.1em; max-width: 900px;">Dukungan dana akan digunakan sesuai dengan rincian kebutuhan yang telah diajukan oleh pengaju dan akan dipantau melalui proses pelaporan Needmap.</p>

        <!-- Kotak Formulir Dana -->
        <div class="form-dana-box mt-50 text-center">
            <h2>Masukkan Jumlah Bantuan</h2>
            <div class="input-rp-container">
                <span class="rp-label">Rp</span>
                <input type="number" class="input-rp" placeholder="">
            </div>
            
            <div class="checkbox-group mt-20">
                <label><input type="checkbox" name="tampil_nama"> Tampilkan nama saya di Jejak Dukungan</label>
                <label><input type="checkbox" name="anonim"> Jadikan dukungan sebagai anonim</label>
            </div>

            <button class="btn-hijau mt-30" style="padding: 10px 50px; font-size: 1.1em;">Kirim</button>
        </div>
    </section>

    <footer class="bg-krem">
        <div class="sosmed-icons">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/yt.png?raw=true" alt="YouTube">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ig.png?raw=true" alt="Instagram">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/x.png?raw=true" alt="X">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/tiktok.png?raw=true" alt="TikTok">
        </div>
        <h3 class="teks-hijau-tua">Ikuti NEEDMAP untuk inspirasi kebaikan terbaru</h3>
        <p class="copyright">© 2026 NEEDMAP. All Rights Reserved</p>
    </footer>
</body>
</html>