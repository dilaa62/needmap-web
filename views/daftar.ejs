<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judulWeb %></title>
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Menggunakan style yang sama dengan masuk.ejs untuk konsistensi */
        .auth-container { max-width: 500px; margin: 40px auto; background: white; padding: 40px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: left; }
        .auth-header { text-align: left; margin-bottom: 20px; }
        .auth-title { font-size: 1.8em; color: #038909; margin-bottom: 20px; font-weight: bold; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-weight: bold; margin-bottom: 8px; color: #038909; font-size: 14px; }
        .form-control { width: 100%; padding: 12px 15px 12px 40px; border: 1px solid #999; border-radius: 10px; font-family: 'Poppins', sans-serif; box-sizing: border-box; outline: none; }
        .form-control:focus { border-color: #038909; }
        .input-icon-wrapper { position: relative; }
        .input-icon-wrapper .icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); font-size: 18px; color: #038909; }
        .btn-auth-hijau { background-color: #038909; color: white; border: none; padding: 15px; border-radius: 30px; font-weight: bold; width: 100%; cursor: pointer; font-size: 1.1em; margin-top: 10px;}
        .btn-auth-outline { background-color: white; color: #038909; border: 2px solid #edd51c; padding: 15px; border-radius: 30px; font-weight: bold; width: 100%; cursor: pointer; font-size: 1.1em; display: block; text-align: center; text-decoration: none; box-sizing: border-box; }
        .garis-atau { display: flex; align-items: center; text-align: center; color: #038909; margin: 20px 0; font-weight: bold; font-size: 14px; }
        .garis-atau::before, .garis-atau::after { content: ''; flex: 1; border-bottom: 1px solid #038909; margin: 0 10px; }
        .syarat-ketentuan { display: flex; align-items: center; font-size: 13px; color: #333; margin-top: 20px; font-weight: bold; }
        .syarat-ketentuan input { margin-right: 10px; }
        .syarat-ketentuan span { color: #a5d04b; }
    </style>
</head>
<body class="bg-krem">
    <header>
        <div class="logo"><img src="https://github.com/dilaa62/NEEDMAP/blob/main/LOGO.png?raw=true" alt="Logo NEEDMAP" class="logo-img"></div>
        <nav>
            <a href="/tentang">Tentang NEEDMAP</a>
            <a href="/perjalanan">Perjalanan Kami</a>
            <a href="/jelajahi">Jelajahi NEED</a>
            <a href="/buat">Buat NEED</a>
            <a href="/insight">Insight dan Berita</a>
            <a href="/masuk" class="btn-masuk active">Masuk/Daftar</a>
        </nav>
    </header>

    <section class="p-50 text-center teks-hijau-tua">
        <h1 style="font-size: 2.2em; margin-bottom: 10px;">Bergabung dengan NEEDMAP!</h1>
        <p style="font-size: 1.1em; max-width: 600px; margin: 0 auto; color: #333;">Buat akun dan mulai temukan cara untuk membantu di sekitarmu.</p>

        <div class="auth-container">
            <div class="auth-header">
                <img src="https://github.com/dilaa62/NEEDMAP/blob/main/LOGO.png?raw=true" alt="Logo" style="height: 40px;">
            </div>
            <h2 class="auth-title">Daftar Akun</h2>

            <form action="#" method="POST">
                <div class="form-group">
                    <label>Nama Lengkap</label>
                    <div class="input-icon-wrapper"><span class="icon">👤</span><input type="text" class="form-control" placeholder="Masukkan nama lengkap"></div>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <div class="input-icon-wrapper"><span class="icon">✉</span><input type="email" class="form-control" placeholder="Masukkan email"></div>
                </div>
                <div class="form-group">
                    <label>Nomor Telepon</label>
                    <div class="input-icon-wrapper"><span class="icon">📞</span><input type="tel" class="form-control" placeholder="Masukkan nomor telepon"></div>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <div class="input-icon-wrapper"><span class="icon">🔒</span><input type="password" class="form-control" placeholder="Buat Password"></div>
                </div>
                <div class="form-group">
                    <label>Konfirmasi Password</label>
                    <div class="input-icon-wrapper"><span class="icon">🔒</span><input type="password" class="form-control" placeholder="Masukkan kembali Password"></div>
                </div>
                
                <label class="syarat-ketentuan">
                    <input type="checkbox"> Saya menyetujui <span>Syarat & Ketentuan</span> NEEDMAP
                </label>

                <button type="submit" class="btn-auth-hijau">DAFTAR SEKARANG</button>
            </form>

            <div class="garis-atau">atau</div>
            <a href="/masuk" class="btn-auth-outline">👤 Sudah punya akun? Masuk</a>
        </div>
    </section>

    <!-- Silakan tambahkan Footer standar di sini -->
</body>
</html>