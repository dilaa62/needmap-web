<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judulWeb %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-krem">
    <!-- HEADER -->
    <header>
        <div class="logo">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/LOGO.png?raw=true" alt="Logo NEEDMAP" class="logo-img">
        </div>
        <nav>
            <a href="/">Tentang Kami</a>
            <a href="/layanan" class="active">Layanan Kami</a>
            <a href="#">Tipe Need</a>
            <a href="#">Map the Needs</a>
            <a href="#">Insight dan Berita</a>
            <a href="#" class="btn-masuk">Masuk/Daftar</a>
        </nav>
    </header>

    <!-- PENCARIAN -->
    <section class="search-section">
        <h2 class="teks-hijau-tua">Apa yang bisa aku bantu hari ini?</h2>
        <div class="search-bar">
            <input type="text" placeholder="Nominal, Barang (Beras, baju dll), Jasa">
            <button class="btn-kuning">Temukan Dampak</button>
        </div>
    </section>

    <!-- MAP SECTION -->
    <section class="map-section">
        <div class="map-container">
            <div class="map-header">
                <img src="" alt="Live Icon"> <span>Live Need Map</span>
            </div>
            <img src="" alt="Peta Lokasi" class="map-image">
        </div>
    </section>

    <!-- KATEGORI KEBUTUHAN -->
    <section class="kebutuhan-section">
        <!-- Mendesak -->
        <div class="kategori-row">
            <h3 class="judul-kategori"><span class="dot dot-merah"></span> Kebutuhan Mendesak!</h3>
            <div class="card-slider">
                <!-- Kartu 1 -->
                <div class="need-card">
                    <div class="card-tags">
                        <span class="tag-verifikasi">Terverifikasi</span>
                        <span class="tag-mendesak">Mendesak</span>
                        <span class="tag-hari">11 hari lagi</span>
                    </div>
                    <img src="" alt="Panti A">
                    <h4>Panti A</h4>
                    <p>Membutuhkan susu bayi</p>
                    <div class="score-bar"><div class="score-fill" style="width: 85%;"></div></div>
                    <p class="score-text">Need Score: 85/100</p>
                    <button class="btn-kuning-outline">Bantu Sekarang</button>
                </div>
                <!-- Kartu 2 -->
                <div class="need-card">
                    <div class="card-tags">
                        <span class="tag-verifikasi">Terverifikasi</span>
                        <span class="tag-mendesak">Mendesak</span>
                        <span class="tag-hari">8 hari lagi</span>
                    </div>
                    <img src="" alt="Panti B">
                    <h4>Panti B</h4>
                    <p>Membutuhkan bahan makanan</p>
                    <div class="score-bar"><div class="score-fill" style="width: 95%;"></div></div>
                    <p class="score-text">Need Score: 95/100</p>
                    <button class="btn-kuning-outline">Bantu Sekarang</button>
                </div>
                <div class="arrow-btn"><img src="" alt="Next"></div>
            </div>
        </div>

        <!-- Prioritas -->
        <div class="kategori-row">
            <h3 class="judul-kategori"><span class="dot dot-oren"></span> Kebutuhan Prioritas</h3>
            <div class="card-slider">
                <!-- Kartu -->
                <div class="need-card">
                    <div class="card-tags">
                        <span class="tag-verifikasi">Terverifikasi</span>
                        <span class="tag-prioritas">Tinggi</span>
                        <span class="tag-hari">23 hari lagi</span>
                    </div>
                    <img src="" alt="Rumah Singgah">
                    <h4>Rumah Singgah B</h4>
                    <p>Membutuhkan pakaian layak pakai</p>
                    <div class="score-bar"><div class="score-fill" style="width: 38%;"></div></div>
                    <p class="score-text">Need Score: 38/100</p>
                    <button class="btn-kuning-outline">Bantu Sekarang</button>
                </div>
                <!-- Kartu -->
                <div class="need-card">
                    <div class="card-tags">
                        <span class="tag-verifikasi">Terverifikasi</span>
                        <span class="tag-prioritas">Tinggi</span>
                        <span class="tag-hari">26 hari lagi</span>
                    </div>
                    <img src="" alt="Panti D">
                    <h4>Panti D</h4>
                    <p>Membutuhkan buku dan alat belajar</p>
                    <div class="score-bar"><div class="score-fill" style="width: 40%;"></div></div>
                    <p class="score-text">Need Score: 40/100</p>
                    <button class="btn-kuning-outline">Bantu Sekarang</button>
                </div>
                <div class="arrow-btn"><img src="" alt="Next"></div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-krem" style="margin-top: 50px;">
        <div class="sosmed-icons">
            <img src="" alt="LinkedIn"><img src="" alt="Instagram"><img src="" alt="X"><img src="" alt="TikTok">
        </div>
        <h3 class="teks-hijau-tua">Ikuti NEEDMAP untuk inspirasi kebaikan terbaru</h3>
        <p class="copyright">© 2026 NEEDMAP. All Rights Reserved</p>
    </footer>
</body>
</html>