<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judulWeb %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-krem">
    <header>
        <div class="logo"><img src="https://github.com/dilaa62/NEEDMAP/blob/main/LOGO.png?raw=true" alt="Logo NEEDMAP" class="logo-img"></div>
        <nav>
            <a href="/tentang">Tentang NEEDMAP</a>
            <a href="/perjalanan">Perjalanan Kami</a>
            <a href="/jelajahi" class="active">Jelajahi NEED</a>
            <a href="/buat">Buat NEED</a>
            <a href="/insight">Insight dan Berita</a>
            <a href="/masuk" class="btn-masuk">Masuk/Daftar</a>
        </nav>
    </header>

    <div class="detail-hero" style="position: relative;">
        <img src="https://github.com/dilaa62/NEEDMAP/blob/main/jn.png?raw=true" alt="<%= panti.nama %>" style="width: 100%; height: 300px; object-fit: cover; background-color: #ddd;">
        <div class="badge-kuning" style="position: absolute; top: 20px; left: 20px;"><%= panti.hariLagi %> hari lagi</div>
    </div>

    <section class="detail-content p-50 bg-white">
        <p class="teks-hijau-tua" style="margin-bottom: 5px;">Need Score: <%= panti.skor %>/100</p>
        <div class="score-bar-large"><div class="score-fill" style="width: <%= panti.skor %>%;"></div></div>
        <p style="text-align: right; font-size: 12px; color: #666; margin-top: 5px;"><%= panti.skor %>% terpenuhi</p>

        <h2 class="teks-hijau-tua mt-30"><%= panti.nama %></h2>
        <h4 class="teks-hijau-tua"><%= panti.deskripsiSingkat %></h4>
        <p style="color: #333; line-height: 1.6;"><%= panti.deskripsiPanjang %></p>

        <h3 class="teks-hijau-tua mt-30">Tentang NEED ini</h3>
        <div class="info-grid">
            <div>
                <p><strong>Pengaju</strong><br>• <%= panti.nama %></p>
                <p><strong>Kategori</strong><br>• <%= panti.kategori %></p>
                <p><strong>Jenis Bantuan</strong><br>• <%= panti.jenisBantuan %></p>
                <p><strong>Kebutuhan</strong><br>• <%= panti.kebutuhanUtama %></p>
            </div>
            <div>
                <p><strong>Jumlah Dibutuhkan</strong><br><%- panti.jumlahDibutuhkan %></p>
                <p><strong>Lokasi</strong><br>• <%= panti.lokasi %></p>
                <p><strong>Batas Waktu</strong><br>• <%= panti.batasWaktu %></p>
            </div>
        </div>

        <div class="text-center mt-50 mb-50">
            <h3 class="teks-hijau-tua">Bantu NEED ini!</h3>
            <p style="font-weight: bold; color: #333;">Sedikit bantuan dapat menjadi langkah besar bagi mereka yang membutuhkan.</p>
            <a href="/pilih-bantuan" class="btn-kuning mt-20" style="display:inline-block; text-decoration:none;">Dukung NEED ini</a>
        </div>
    </section>
</body>
</html>