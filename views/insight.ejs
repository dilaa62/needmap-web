                    <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib5.png?raw=true" alt="Kabar 1" class="kabar-img">
                    <div>
                        <span style="font-size: 12px; color: #ddd;">20 Oktober 2026</span> <span class="tag-kategori bg-kuning teks-hijau-tua" style="margin-left: 10px;">Kabar NEEDMAP</span>
                        <h4 style="margin-top: 5px; margin-bottom: 0;">NEEDMAP Hadirkan Cara Baru untuk Menemukan Kebutuhan di Sekitar Kita</h4>
                    </div>
                </div>
                <!-- List 2 -->
                <div class="kabar-item">
                    <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib6.png?raw=true" alt="Kabar 2" class="kabar-img">
                    <div>
                        <span style="font-size: 12px; color: #ddd;">7 September 2026</span> <span class="tag-kategori bg-kuning teks-hijau-tua" style="margin-left: 10px;">Kegiatan</span>
                        <h4 style="margin-top: 5px; margin-bottom: 0;">Bersama Komunitas, Membangun Gerakan Donasi yang Lebih Bermakna</h4>
                    </div>
