        <!-- TAHUKAH KAMU -->
        <div class="tahukah-kamu-box radius-20 p-30 flex-row mt-50" style="background-color: #f4f6dc;">
            <div style="width: 150px; text-align: center;"><img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib75-removebg-preview.png?raw=true" alt="Puzzle Icon" style="width: 100px; height: 100px; background: #a5d04b; border-radius: 10px;"></div>
            <div class="flex-1 teks-hijau-tua">
                <h2 style="margin-bottom: 5px;">TAHUKAH KAMU?</h2>
                <p style="font-weight: bold; margin-bottom: 5px;">Tidak semua kebutuhan harus dipenuhi dengan uang.</p>
                <p style="margin-top: 0;">Barang, makanan, waktu, keterampilan, hingga dukungan lainnya juga dapat menjadi bentuk bantuan yang berarti.</p>
            </div>
        </div>

        <!-- INSIGHT PILIHAN -->
        <div class="mt-50">
            <div class="flex-between">
                <div>
                    <h2 class="teks-hijau-tua" style="margin-bottom: 5px;">Insight Pilihan</h2>
                    <p class="teks-hijau-tua" style="font-weight: bold; margin-top: 0;">Bantuan yang lebih tepat dimulai dari memahami kebutuhan.</p>
                </div>
                <a href="#" class="teks-hijau-tua" style="font-weight: bold; text-decoration: none;">Lihat Semua →</a>
            </div>

            <div class="insight-pilihan-grid mt-30">
                <!-- Kartu Besar Kiri -->
                <div class="card-pilihan-kiri bg-white radius-20">
                    <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib8.png?raw=true" alt="Insight 1" class="img-kiri">
                    <div class="p-30">
                        <span class="tag-kategori bg-kuning teks-hijau-tua">Insight</span>
                        <span style="font-size: 12px; color: #777; margin-left: 10px;">12 September 2026</span>
                        <h3 class="teks-hijau-tua mt-10">Memahami Kebutuhan, Membangun Dampak yang Lebih Luas</h3>
                        <p style="font-size: 14px; color: #555; margin-bottom: 25px; line-height: 1.6;">Bagaimana bantuan yang tepat dapat memberikan dampak nyata bagi penerimanya...</p>
                        <a href="#" class="btn-kuning" style="text-decoration: none; display:inline-block; padding: 12px 25px; border-radius: 20px;">Baca Selengkapnya →</a>
                    </div>
                </div>

                <!-- 2 Kartu Kecil Kanan -->
                <div class="grid-kanan">
                    <!-- Kartu Kanan 1 -->
                    <div class="card-pilihan-kanan bg-white radius-20 p-20">
                        <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib9.png?raw=true" alt="Insight 2" class="img-kanan">
                        <div class="konten-kanan">
                            <span class="tag-kategori bg-kuning teks-hijau-tua">Tips Donasi</span>
                            <h3 class="teks-hijau-tua mt-10" style="font-size: 1.1em; margin-bottom: 5px;">Donasi yang Tepat, Bukan Sekadar Memberi</h3>
                            <p style="font-size: 13px; color: #555; margin-bottom: 15px;">Tips sederhana agar bantuanmu lebih berdampak.</p>
                            <a href="#" class="btn-kuning" style="text-decoration: none; display:inline-block; padding: 8px 15px; font-size: 12px; border-radius: 20px;">Baca Selengkapnya →</a>
                        </div>
                    </div>
                    <!-- Kartu Kanan 2 -->
                    <div class="card-pilihan-kanan bg-white radius-20 p-20">
                        <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib10.png?raw=true" alt="Insight 3" class="img-kanan">
                        <div class="konten-kanan">
                            <span class="tag-kategori bg-kuning teks-hijau-tua">Komunitas</span>
                            <h3 class="teks-hijau-tua mt-10" style="font-size: 1.1em; margin-bottom: 5px;">Aksi Kecil, Dampak Besar</h3>
                            <p style="font-size: 13px; color: #555; margin-bottom: 15px;">Bagaimana kolaborasi komunitas membawa perubahan nyata.</p>
                            <a href="#" class="btn-kuning" style="text-decoration: none; display:inline-block; padding: 8px 15px; font-size: 12px; border-radius: 20px;">Baca Selengkapnya →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BANNER PENUTUP -->
        <div class="banner-penutup bg-hijau-muda radius-20 p-50 flex-row mt-50">
            <div class="flex-1 teks-hijau-tua">
                <h2 style="font-size: 1.8em; margin-bottom: 10px;">Setiap kebutuhan punya cerita.<br>Mari jadi bagian dari perubahan.</h2>
                <p style="margin-bottom: 30px;">Temukan kebutuhan di sekitarmu dan berikan bantuan yang benar-benar dibutuhkan.</p>
                <div style="display: flex; gap: 15px;">
                    <a href="/jelajahi" class="btn-hijau" style="text-decoration: none; padding: 12px 25px;">Jelajahi Kebutuhan →</a>
                    <a href="/buat" style="text-decoration: none; padding: 12px 25px; border: 2px solid #038909; color: #038909; border-radius: 20px; font-weight: bold;">Buat NEED</a>
                </div>
            </div>
            <div style="width: 150px;"><img src="https://github.com/dilaa62/NEEDMAP/blob/main/ib11-removebg-preview%20(1).png?raw=true" alt="Puzzle Icon" style="width: 120px; height: 120px; background: #edd51c; border-radius: 10px;"></div>
        </div>

    <footer class="bg-krem">
        <div class="sosmed-icons">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/yt.png?raw=true" alt="YouTube">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/ig.png?raw=true" alt="Instagram">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/x.png?raw=true" alt="X">
            <img src="https://github.com/dilaa62/NEEDMAP/blob/main/tiktok.png?raw=true" alt="TikTok">
        </div>
        <h3 class="teks-hijau-tua">Ikuti NEEDMAP untuk inspirasi kebaikan terbaru</h3>
        <p class="copyright">© 2026 NEEDMAP. All Rights Reserved</p>
    </footer>

    <!-- Script Filter Kategori -->
    <script>
        function filterTopik(topik, element) {
            // Ubah tombol aktif
            document.querySelectorAll('.btn-filter').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');

            // Filter kartu artikel
            const articles = document.querySelectorAll('.artikel-item');
            articles.forEach(card => {
                if (topik === 'Semua' || card.getAttribute('data-topik') === topik) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>