    <!-- Script Peta Leaflet (Wajib ditaruh di bawah) -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Set peta di Jakarta
        var map = L.map('map').setView([-6.250000, 106.816666], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

        // Pin 1: Panti A
        L.marker([-6.280000, 106.820000]).addTo(map).bindPopup('<b>Panti A</b><br>Susu Bayi<br><a href="/detail/panti-a">Bantu</a>');
        // Pin 2: Panti B
        L.marker([-6.230000, 106.880000]).addTo(map).bindPopup('<b>Panti B</b><br>Bahan Makanan<br><a href="/detail/panti-b">Bantu</a>');
    </script>
</body>
</html>