<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judulWeb %></title>
    <!-- CSS Utama Anda -->
    <link rel="stylesheet" href="/style.css">
    <!-- Leaflet CSS untuk Peta -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- JURUS ISOLASI DESAIN: Memastikan halaman ini rapi tanpa gangguan CSS lain -->
    <style>
        .jelajahi-container { max-width: 900px; margin: 0 auto; padding: 40px 20px; box-sizing: border-box; }
        
        /* Baris Pencarian */
        .search-box-wrapper { display: flex; align-items: center; border: 2px solid #333; border-radius: 30px; padding: 5px 5px 5px 20px; background: white; max-width: 600px; margin: 20px auto; }
        .search-box-wrapper input { flex: 1; border: none; outline: none; font-size: 14px; background: transparent; }
        .btn-temukan { background-color: #edd51c; color: #038909; padding: 10px 20px; border-radius: 25px; border: none; font-weight: bold; cursor: pointer; white-space: nowrap; }

        /* Kotak Live Map */
        .live-map-box { background-color: #a5d04b; border-radius: 20px; padding: 20px; margin-bottom: 40px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .map-inner { width: 100%; height: 250px; border-radius: 15px; overflow: hidden; border: 3px solid white; position: relative; z-index: 1;}

        /* Kategori & Grid Kartu */
        .kategori-title { display: flex; align-items: center; gap: 10px; color: #038909; font-size: 1.5em; margin-bottom: 20px; font-weight: bold; }
        .dot { width: 15px; height: 15px; border-radius: 50%; display: inline-block; }
        .row-kartu { display: flex; align-items: center; gap: 20px; margin-bottom: 50px; }
        .grid-2-kartu { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; flex: 1; }
        
        /* Kartu Desain Presisi */
        .card-j { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.08); border: 1px solid #eee; display: flex; flex-direction: column; }
        .card-j-img-box { position: relative; width: 100%; height: 160px; background: #ddd; }
        .card-j-img-box img { width: 100%; height: 100%; object-fit: cover; }
        
        /* Tag / Lencana di dalam gambar */
        .tags-atas { position: absolute; top: 10px; left: 10px; display: flex; gap: 5px; flex-wrap: wrap; z-index: 2; }
        .tag-badge { padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: bold; }
        .tag-bawah { position: absolute; top: 40px; left: 10px; z-index: 2; }
        
        .card-j-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
        .card-j-body h3 { margin: 0 0 5px 0; color: #038909; font-size: 1.1em; }
        .card-j-body p.desc { margin: 0 0 15px 0; font-size: 13px; color: #555; }
        
        /* Bar Skor */
        .bar-bg { width: 100%; height: 6px; background: #e0e0e0; border-radius: 3px; margin: 5px 0; }
        .bar-fill { height: 100%; background: #038909; border-radius: 3px; }
        
        .btn-bantu-skrg { background-color: #edd51c; color: #038909; padding: 12px; border-radius: 20px; text-align: center; text-decoration: none; font-weight: bold; display: block; margin-top: auto; }
        .btn-panah { width: 40px; height: 40px; border-radius: 50%; background-color: #edd51c; color: white; border: none; font-size: 18px; cursor: pointer; display: flex; justify-content: center; align-items: center; flex-shrink: 0; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }

        /* Responsif HP */
        @media (max-width: 768px) {
            .grid-2-kartu { grid-template-columns: 1fr; }
            .btn-panah { display: none; }
            .search-box-wrapper { flex-direction: column; border: none; padding: 0; background: transparent; }
            .search-box-wrapper input { border: 2px solid #333; border-radius: 30px; padding: 12px 20px; margin-bottom: 10px; width: 100%; box-sizing: border-box; }
            .btn-temukan { width: 100%; }
        }
    </style>
</head>
<body class="bg-krem">
    <header>
        <div class="logo"><img src="https://github.com/dilaa62/NEEDMAP/blob/main/LOGO.png?raw=true" alt="Logo NEEDMAP" class="logo-img"></div>
        <nav>
            <a href="/tentang">Tentang NEEDMAP</a>
            <a href="/perjalanan">Perjalanan Kami</a>
